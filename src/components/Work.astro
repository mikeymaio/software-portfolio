---
import { getProjects } from '../lib/projects'
import ProjectList from './ProjectList.astro'

const projects = await getProjects()
const featured = projects.filter((p) => p.featured)
const rest = projects.filter((p) => !p.featured)
---

<section id="work" class="work wrap">
  <h2><span class="sec-no">Side A</span> Selected work</h2>
  <ProjectList id="featured-projects" label="Featured projects" projects={featured} start={1} />
  <!-- #55: the toggle goes after this list and uses aria-controls="more-projects". -->
  <ProjectList id="more-projects" label="More projects" projects={rest} start={featured.length + 1} more />
</section>

<style>
  .work {
    padding-top: clamp(56px, 8vw, 104px);
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .sec-no {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
