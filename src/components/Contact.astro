---
import Marked from './Marked.astro'
const { closingLine, email, githubUrl, linkedinUrl, resumeHref } = Astro.props
---

<section id="contact" class="contact wrap" aria-label="Contact">
  <p class="closing"><Marked text={closingLine} /></p>
  <p class="links">
    <a class="text-link" href={`mailto:${email}`}>{email}</a>
    <a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a class="text-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a class="text-link" href={resumeHref}>Resume</a>
  </p>
</section>

<style>
  .contact {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .closing {
    margin: 0;
    max-width: 17em;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 28px 0 0;
  }
</style>
