---
import type { Project } from '../lib/projects'
import { projectLinks } from '../lib/projects'
import Marked from './Marked.astro'
import Credit from './Credit.astro'

interface Props {
  id: string
  label: string
  projects: Project[]
  start: number
  more?: boolean
}
const { id, label, projects, start, more = false } = Astro.props
---

{
  projects.length > 0 && (
    <ol id={id} class:list={['tracks', { more }]} aria-label={label}>
      {projects.map((p, i) => (
        <li class="track">
          <div class="num">{String(start + i).padStart(2, '0')}</div>
          <div class="head">
            <h3><Marked text={p.name} /></h3>
            <p class="summary"><Marked text={p.summary} /></p>
            {p.retiredCompanion && <p class="retired"><Marked text={p.retiredCompanion} /> (retired)</p>}
            {projectLinks(p).length > 0 && (
              <p class="links">
                {projectLinks(p).map((l) => (
                  <a class="text-link" href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </div>
          <dl class="credits">
            <Credit term="Client" value={p.client} />
            <Credit term="Role" value={p.role} />
            <Credit term="Years" value={p.years} />
            <Credit term="Stack" list={p.stack} />
          </dl>
        </li>
      ))}
    </ol>
  )
}

<style>
  .tracks {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .tracks.more {
    border-top: 0;
  }
  .track {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 8px 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }
  .num {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 14px;
    padding-top: 0.55em;
  }
  .summary {
    margin: 0.4em 0 0;
    color: var(--muted);
    max-width: 30em;
  }
  .retired {
    margin: 0.4em 0 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .links {
    margin: 0.8em 0 0;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .credits {
    margin: 0;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.5;
  }
  @media (max-width: 860px) {
    .track {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .credits {
      grid-column: 2;
    }
  }
  @media (max-width: 560px) {
    .track {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .credits {
      grid-column: 1;
      margin-top: 12px;
    }
    .num {
      padding-top: 0;
    }
  }
</style>
