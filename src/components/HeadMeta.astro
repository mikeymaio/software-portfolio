---
// Title, description, canonical, icons, Open Graph and Twitter card.
// Absolute URLs are built from the configured site (astro.config.mjs).
import { url } from '../lib/url'

const { title, description } = Astro.props
const absolute = (path = '') => new URL(url(path), Astro.site).href
const canonical = absolute()
const image = absolute('og-image.png')
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="icon" href={url('icon-192.png')} type="image/png" sizes="192x192" />
<link rel="icon" href={url('favicon.ico')} sizes="48x48" />
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Michael Maio" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title}: ${description}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
