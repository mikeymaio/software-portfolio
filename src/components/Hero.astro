---
import Signature from './Signature.astro'
const { name, positioningLine, contextSentence, email, resumeHref } = Astro.props
---

<section id="top" class="hero wrap">
  <h1>{name}</h1>
  <p class="position">{positioningLine}</p>
  <p class="context">{contextSentence}</p>
  <p class="actions">
    <a class="btn primary" href={resumeHref}>Resume</a>
    <a class="btn" href={`mailto:${email}`}>Email me</a>
  </p>
  <Signature />
</section>

<style>
  .hero {
    padding-top: clamp(56px, 9vw, 120px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }
  h1 {
    margin-left: -0.03em;
  }
  .position {
    margin: 32px 0 0;
    max-width: 21em;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(23px, 2.7vw, 38px);
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .context {
    margin: 18px 0 0;
    max-width: 40em;
    color: var(--muted);
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 0;
  }
</style>
