---
import { waveformSvg } from '../lib/waveform'

// Three bar densities, switched by media query, so bars stay close to 2px at every width.
const HEIGHT = 96
const variants = [
  { name: 'sm', width: 320 },
  { name: 'md', width: 560 },
  { name: 'lg', width: 1004 },
].map((v) => ({ ...v, svg: waveformSvg({ width: v.width, height: HEIGHT, played: 0.35, seed: 11 }) }))
---

<div class="signature" aria-hidden="true">
  {variants.map((v) => <div class={`wave ${v.name}`} set:html={v.svg} />)}
</div>

<style is:global>
  .signature {
    margin-top: clamp(40px, 6vw, 72px);
    height: 96px;
  }
  .signature .wave {
    display: none;
    height: 100%;
  }
  .signature .wave-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .signature .sm { display: block; }
  @media (min-width: 480px) {
    .signature .sm { display: none; }
    .signature .md { display: block; }
  }
  @media (min-width: 860px) {
    .signature .md { display: none; }
    .signature .lg { display: block; }
  }
  .signature .played, .signature .playhead { fill: var(--accent); }
  .signature .rest { fill: var(--wave-muted); }

  @media (prefers-reduced-motion: no-preference) {
    .signature .played { animation: wave-play 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.3s backwards; }
    .signature .playhead { animation: wave-head 0.3s ease-out 1.5s backwards; }
  }
  @keyframes wave-play { from { clip-path: inset(0 100% 0 0); } }
  @keyframes wave-head { from { opacity: 0; } }
</style>
